<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is allowed only for the loopback address, which is where the Jarvis
  server runs when Termux hosts it on this same phone. Everything else must be
  HTTPS: a backend reachable over the network carries an API key, and sending
  that in the clear would hand it to anyone on the same Wi-Fi.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
